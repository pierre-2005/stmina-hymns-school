# ---------------------------------------------------------
# St. Mina Hymns School v3
# Copy to .env only for local Docker testing.
# In Portainer, enter these as stack environment variables.
# NEVER commit your real .env file or secrets.
# ---------------------------------------------------------

# Generate secrets with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-secret
CONTENT_API_SECRET=replace-with-a-different-long-random-secret
CONTENT_API_TOKEN_TTL=7200

ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Site Administrator
ADMIN_PASSWORD=replace-with-a-strong-password

# Browser-based admin recovery key. Use at least 20 characters.
ADMIN_SETUP_KEY=replace-with-a-long-private-recovery-key

# Optional GitHub backup settings.
# Use a fine-grained token that can write repository contents for this repository.
GITHUB_TOKEN=
GITHUB_REPO=pierre-2005/stmina-hymns-school
GITHUB_BRANCH=main
GITHUB_CONTENT_PATH=content/site-content.json

# Optional. In Portainer, enable the stack webhook and paste the copied URL here.
PORTAINER_WEBHOOK_URL=
